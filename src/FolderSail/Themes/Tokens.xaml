<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      Colours taken from Finder in light mode:
      frosted sidebar #F6F6F6, white file stage, #007AFF selection with white type.
    -->
    <SolidColorBrush x:Key="Surface.Window" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Surface.Canvas" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Surface.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface.Toolbar" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Surface.Sidebar" Color="#FBFBFB" />
    <SolidColorBrush x:Key="Surface.Subtle" Color="#F7F7F7" />
    <SolidColorBrush x:Key="Surface.Hover" Color="#0F000000" />
    <SolidColorBrush x:Key="Surface.Selected" Color="#007AFF" />
    <SolidColorBrush x:Key="Surface.SidebarHover" Color="#0F000000" />
    <SolidColorBrush x:Key="Surface.SidebarSelected" Color="#EFEFEF" />

    <SolidColorBrush x:Key="Line.Soft" Color="#E8E8E8" />
    <SolidColorBrush x:Key="Line.Base" Color="#DEDEDE" />
    <SolidColorBrush x:Key="Line.Strong" Color="#D0D0D0" />

    <SolidColorBrush x:Key="Text.Primary" Color="#1D1D1F" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#6E6E73" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#8E8E93" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Accent.Base" Color="#007AFF" />
    <SolidColorBrush x:Key="Accent.Deep" Color="#0066D6" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#1A007AFF" />
    <SolidColorBrush x:Key="Accent.Muted" Color="#66007AFF" />

    <SolidColorBrush x:Key="Danger.Base" Color="#FF3B30" />
    <SolidColorBrush x:Key="Danger.Soft" Color="#22FF3B30" />

    <SolidColorBrush x:Key="Accent.Wake" Color="#007AFF" />
    <SolidColorBrush x:Key="Accent.WakeFaded" Color="#00000000" />

    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <sys:Double x:Key="Size.Row">28</sys:Double>
    <sys:Double x:Key="Size.FontBody">13</sys:Double>
    <sys:Double x:Key="Size.FontSmall">11</sys:Double>

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe MDL2 Assets</FontFamily>

    <DropShadowEffect x:Key="Shadow.Card"
                      BlurRadius="16"
                      ShadowDepth="1"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.06" />

    <DropShadowEffect x:Key="Shadow.Soft"
                      BlurRadius="8"
                      ShadowDepth="0"
                      Color="#000000"
                      Opacity="0.04" />
</ResourceDictionary>
