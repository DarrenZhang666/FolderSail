<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      Night theme, close to OneCommander:
      charcoal-navy stage, muted row selection, off-white type (not glaring white).
    -->
    <SolidColorBrush x:Key="Surface.Window" Color="#1B1F24" />
    <SolidColorBrush x:Key="Surface.Canvas" Color="#1E2227" />
    <SolidColorBrush x:Key="Surface.Card" Color="#21252B" />
    <SolidColorBrush x:Key="Surface.Toolbar" Color="#1B1F24" />
    <SolidColorBrush x:Key="Surface.Sidebar" Color="#191C21" />
    <SolidColorBrush x:Key="Surface.Subtle" Color="#2A2F36" />
    <SolidColorBrush x:Key="Surface.Hover" Color="#2E343C" />
    <SolidColorBrush x:Key="Surface.Selected" Color="#3E4451" />
    <SolidColorBrush x:Key="Surface.SidebarHover" Color="#2A2F36" />
    <SolidColorBrush x:Key="Surface.SidebarSelected" Color="#2E343C" />
    <SolidColorBrush x:Key="Surface.Brand" Color="#2E343C" />

    <SolidColorBrush x:Key="Line.Soft" Color="#2C313A" />
    <SolidColorBrush x:Key="Line.Base" Color="#343B44" />
    <SolidColorBrush x:Key="Line.Strong" Color="#3E4451" />
    <SolidColorBrush x:Key="Line.Focus" Color="#5C6370" />

    <SolidColorBrush x:Key="Text.Primary" Color="#D7DAE0" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#9AA3B0" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#7D8694" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#E8EAED" />

    <SolidColorBrush x:Key="Accent.Base" Color="#5B8DEF" />
    <SolidColorBrush x:Key="Accent.Deep" Color="#7AA2F7" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#335B8DEF" />
    <SolidColorBrush x:Key="Accent.Muted" Color="#665B8DEF" />
    <SolidColorBrush x:Key="Accent.FocusLine" Color="#4A6FA8" />
    <SolidColorBrush x:Key="Accent.FocusHalo" Color="#24344C" />

    <SolidColorBrush x:Key="Danger.Base" Color="#E06C75" />
    <SolidColorBrush x:Key="Danger.Soft" Color="#33E06C75" />

    <SolidColorBrush x:Key="Traffic.Close" Color="#FF5F57" />
    <SolidColorBrush x:Key="Traffic.ClosePressed" Color="#E0483E" />
    <SolidColorBrush x:Key="Traffic.Min" Color="#FEBC2E" />
    <SolidColorBrush x:Key="Traffic.MinPressed" Color="#E0A325" />
    <SolidColorBrush x:Key="Traffic.Max" Color="#28C840" />
    <SolidColorBrush x:Key="Traffic.MaxPressed" Color="#1AAB29" />
    <SolidColorBrush x:Key="Traffic.Glyph" Color="#2A2F36" />

    <SolidColorBrush x:Key="Accent.Wake" Color="#5B8DEF" />
    <SolidColorBrush x:Key="Accent.WakeFaded" Color="#00000000" />

    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <sys:Double x:Key="Size.Row">28</sys:Double>
    <sys:Double x:Key="Size.FontBody">13</sys:Double>
    <sys:Double x:Key="Size.FontSmall">11</sys:Double>

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe MDL2 Assets</FontFamily>

    <DropShadowEffect x:Key="Shadow.Card"
                      BlurRadius="18"
                      ShadowDepth="1"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.40" />

    <DropShadowEffect x:Key="Shadow.Soft"
                      BlurRadius="8"
                      ShadowDepth="0"
                      Color="#000000"
                      Opacity="0.24" />

    <DropShadowEffect x:Key="Shadow.PaneActive"
                      BlurRadius="12"
                      ShadowDepth="0"
                      Color="#000000"
                      Opacity="0.42" />
</ResourceDictionary>
