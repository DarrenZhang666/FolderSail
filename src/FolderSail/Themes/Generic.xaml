<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:FolderSail.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:FileSizeConverter x:Key="FileSize" />
    <conv:LayoutModeToBoolConverter x:Key="LayoutModeToBool" />
    <conv:RelativeTimeConverter x:Key="RelativeTime" />
    <conv:RelativeTimeBrushConverter x:Key="RelativeTimeBrush" />
    <conv:ItemKindLabelConverter x:Key="ItemKindLabel" />
    <conv:RatioToWidthConverter x:Key="RatioToWidth" />

    <!--
      No implicit TextBlock style here on purpose: an implicit style would win over the
      FontFamily that icon buttons inherit from their own style, turning every Segoe MDL2
      glyph into a blank box. Typography is set once on the window and inherits down.
    -->

    <Style x:Key="GlyphText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="GlyphTextSmall" TargetType="TextBlock" BasedOn="{StaticResource GlyphText}">
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="MetaText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Size.FontSmall}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Tertiary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
