<UserControl x:Class="FolderSail.Views.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewMouseDown="OnPaneMouseDown"
             AllowDrop="True"
             DragOver="OnDragOver"
             DragLeave="OnDragLeave"
             Drop="OnDrop"
             FontFamily="{StaticResource Font.Ui}"
             FontSize="{StaticResource Size.FontBody}"
             Foreground="{StaticResource Text.Primary}">

    <Border x:Name="Card"
            Background="{StaticResource Surface.Card}"
            BorderBrush="{StaticResource Line.Base}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Card}"
            Margin="5"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Wake bar: the active pane leaves a teal trail across its top edge. -->
            <Border x:Name="WakeBar"
                    Grid.Row="0"
                    Background="{StaticResource Accent.WakeFaded}"
                    CornerRadius="9,9,0,0" />

            <!-- Tab strip: each split pane owns its own independent tab collection. -->
            <Grid Grid.Row="1" Margin="8,6,8,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IconButtonSmall}"
                            Content="&#xE710;"
                            Margin="3,0,2,0"
                            ToolTip="新建标签页 (Ctrl+T)"
                            Command="{Binding NewTabCommand}" />

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TabChrome"
                                            Height="28"
                                            MinWidth="82"
                                            MaxWidth="170"
                                            Margin="0,0,3,0"
                                            Padding="8,0,3,0"
                                            Background="{StaticResource Surface.Subtle}"
                                            BorderBrush="{StaticResource Line.Soft}"
                                            BorderThickness="1"
                                            CornerRadius="6,6,3,3"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            MouseDown="OnTabMouseDown">
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="新建标签页"
                                                          InputGestureText="Ctrl+T"
                                                          Command="{Binding Tag.NewTabCommand}" />
                                                <MenuItem Header="复制标签页"
                                                          Command="{Binding Tag.DuplicateTabCommand}"
                                                          CommandParameter="{Binding DataContext}" />
                                                <Separator />
                                                <MenuItem Header="关闭标签页"
                                                          InputGestureText="Ctrl+W"
                                                          Command="{Binding Tag.CloseTabCommand}"
                                                          CommandParameter="{Binding DataContext}" />
                                                <MenuItem Header="关闭其他标签页"
                                                          Command="{Binding Tag.CloseOtherTabsCommand}"
                                                          CommandParameter="{Binding DataContext}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="&#xE8B7;"
                                                       FontFamily="{StaticResource Font.Icon}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Text.Tertiary}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding Path}" />
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource IconButtonSmall}"
                                                    Width="20"
                                                    Height="20"
                                                    Margin="4,0,0,0"
                                                    Content="&#xE711;"
                                                    ToolTip="关闭标签页"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource Surface.Card}" />
                                            <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource Accent.Muted}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButtonSmall}"
                            Content="&#xE72C;"
                            ToolTip="刷新 (F5)"
                            Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource IconButtonSmall}"
                            Content="&#xE8A7;"
                            ToolTip="在资源管理器中打开"
                            Command="{Binding OpenInExplorerCommand}" />
                </StackPanel>
            </Grid>

            <!-- Navigation strip: breadcrumb by default, editable path on demand -->
            <Grid Grid.Row="2" Margin="8,0,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,4,0">
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE72B;"
                            ToolTip="后退"
                            Command="{Binding GoBackCommand}" />
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE72A;"
                            ToolTip="前进"
                            Command="{Binding GoForwardCommand}" />
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE74A;"
                            ToolTip="上一级"
                            Command="{Binding GoUpCommand}" />
                </StackPanel>

                <!-- Breadcrumb -->
                <Border Grid.Column="1"
                        Background="{StaticResource Surface.Subtle}"
                        BorderBrush="{StaticResource Line.Soft}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Control}"
                        Padding="2,0"
                        MinHeight="26"
                        Visibility="{Binding IsAddressEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource CrumbButton}"
                                                Command="{Binding NavigateCommand}">
                                            <TextBlock Text="{Binding Label}" />
                                        </Button>
                                        <TextBlock Text="&#xE76C;"
                                                   FontFamily="{StaticResource Font.Icon}"
                                                   FontSize="8"
                                                   Foreground="{StaticResource Text.Tertiary}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsLast, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Editable path -->
                <TextBox x:Name="AddressInput"
                         Grid.Column="1"
                         Style="{StaticResource AddressBox}"
                         Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnAddressKeyDown"
                         Visibility="{Binding IsAddressEditing, Converter={StaticResource BoolToVisibility}}" />

                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Content="&#xE70F;"
                        Margin="4,0,0,0"
                        ToolTip="编辑路径"
                        Command="{Binding BeginEditAddressCommand}" />
            </Grid>

            <!-- Column headers -->
            <Border Grid.Row="3"
                    BorderBrush="{StaticResource Line.Soft}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0,14,5"
                    Margin="8,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ColumnLabel}" Text="名称" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnLabel}" Text="大小" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnLabel}" Text="更新" TextAlignment="Center" />
                    <TextBlock Grid.Column="3" Style="{StaticResource ColumnLabel}" Text="类型" TextAlignment="Right" />
                </Grid>
            </Border>

            <!-- Rows -->
            <ListBox Grid.Row="4"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource FileRow}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="8,2,4,2"
                     Padding="0"
                     FontFamily="{StaticResource Font.Ui}"
                     FontSize="{StaticResource Size.FontBody}"
                     Foreground="{StaticResource Text.Primary}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="OnItemDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="26"
                              PreviewMouseMove="OnRowMouseMove"
                              PreviewMouseRightButtonDown="OnRowRightClick">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding Icon}"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Size, Converter={StaticResource FileSize}}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontSize="{StaticResource Size.FontSmall}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <!-- Age pill: recency is colour-coded so stale folders recede. -->
                            <Border Grid.Column="2"
                                    Background="{Binding ModifiedUtc, Converter={StaticResource RelativeTimeBrush}}"
                                    CornerRadius="{StaticResource Radius.Pill}"
                                    Padding="6,1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ModifiedUtc, Converter={StaticResource RelativeTime}}"
                                           Foreground="{Binding ModifiedUtc, Converter={StaticResource RelativeTimeBrush}, ConverterParameter=Foreground}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>

                            <TextBlock Grid.Column="3"
                                       Text="{Binding Kind, Converter={StaticResource ItemKindLabel}}"
                                       Foreground="{StaticResource Text.Tertiary}"
                                       FontSize="10"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer: counts on the left, file actions on the right -->
            <Border Grid.Row="5"
                    Background="{StaticResource Surface.Subtle}"
                    BorderBrush="{StaticResource Line.Soft}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,9,9"
                    Padding="12,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding ItemSummary}"
                               Foreground="{StaticResource Text.Tertiary}"
                               FontSize="{StaticResource Size.FontSmall}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonSmall}" Content="&#xE8F4;" ToolTip="新建文件夹" Command="{Binding NewFolderCommand}" />
                        <Button Style="{StaticResource IconButtonSmall}" Content="&#xE8C8;" ToolTip="复制 (Ctrl+C)" Command="{Binding CopySelectedCommand}" />
                        <Button Style="{StaticResource IconButtonSmall}" Content="&#xE8C6;" ToolTip="剪切 (Ctrl+X)" Command="{Binding CutSelectedCommand}" />
                        <Button Style="{StaticResource IconButtonSmall}" Content="&#xE77F;" ToolTip="粘贴 (Ctrl+V)" Command="{Binding PasteCommand}" />
                        <Button Style="{StaticResource IconButtonDanger}" Content="&#xE74D;" ToolTip="删除 (Delete)" Command="{Binding DeleteSelectedCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
