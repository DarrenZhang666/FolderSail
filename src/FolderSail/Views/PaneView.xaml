<UserControl x:Class="FolderSail.Views.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FolderSail.Core.Models;assembly=FolderSail.Core"
             PreviewMouseDown="OnPaneMouseDown"
             AllowDrop="True"
             DragOver="OnDragOver"
             DragLeave="OnDragLeave"
             Drop="OnDrop"
             FontFamily="{StaticResource Font.Ui}"
             FontSize="{StaticResource Size.FontBody}"
             Foreground="{DynamicResource Text.Primary}">

    <Border x:Name="Card"
            Background="{DynamicResource Surface.Card}"
            BorderBrush="{DynamicResource Line.Soft}"
            BorderThickness="2"
            CornerRadius="0"
            Margin="0"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="6,2,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,4,0">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabChrome"
                                        Height="26"
                                        MinWidth="78"
                                        MaxWidth="168"
                                        Margin="0,0,2,0"
                                        Padding="8,0,2,0"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        MouseDown="OnTabMouseDown">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{DynamicResource Loc.NewTab}"
                                                      InputGestureText="Ctrl+T"
                                                      Command="{Binding Tag.NewTabCommand}" />
                                            <MenuItem Header="{DynamicResource Loc.DuplicateTab}"
                                                      Command="{Binding Tag.DuplicateTabCommand}"
                                                      CommandParameter="{Binding DataContext}" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Loc.CloseTab}"
                                                      InputGestureText="Ctrl+W"
                                                      Command="{Binding Tag.CloseTabCommand}"
                                                      CommandParameter="{Binding DataContext}" />
                                            <MenuItem Header="{DynamicResource Loc.CloseOtherTabs}"
                                                      Command="{Binding Tag.CloseOtherTabsCommand}"
                                                      CommandParameter="{Binding DataContext}" />
                                            <MenuItem Header="{DynamicResource Loc.CloseAllTabs}"
                                                      Command="{Binding Tag.CloseAllTabsCommand}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE8B7;"
                                                   FontFamily="{StaticResource Font.Icon}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Text.Tertiary}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="Normal"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding Path}" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource IconButtonSmall}"
                                                Width="20"
                                                Height="20"
                                                Margin="4,0,0,0"
                                                Content="&#xE711;"
                                                ToolTip="{DynamicResource Loc.CloseTab}"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Quick jump: This PC / Desktop / Documents / Downloads / Pictures -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="2,0,6,0">
                    <Button Style="{StaticResource IconButtonSmall}"
                            Content="&#xE977;"
                            ToolTip="{DynamicResource Loc.ThisPc}"
                            Command="{Binding GoToThisPcCommand}" />
                    <Button Style="{StaticResource IconButtonSmall}"
                            Content="&#xE7F4;"
                            ToolTip="{DynamicResource Loc.Desktop}"
                            Command="{Binding OpenKnownFolderCommand}"
                            CommandParameter="Desktop" />
                    <Button Style="{StaticResource IconButtonSmall}"
                            Content="&#xE8A5;"
                            ToolTip="{DynamicResource Loc.Documents}"
                            Command="{Binding OpenKnownFolderCommand}"
                            CommandParameter="Documents" />
                    <Button Style="{StaticResource IconButtonSmall}"
                            Content="&#xE896;"
                            ToolTip="{DynamicResource Loc.Downloads}"
                            Command="{Binding OpenKnownFolderCommand}"
                            CommandParameter="Downloads" />
                    <Button Style="{StaticResource IconButtonSmall}"
                            Content="&#xEB9F;"
                            ToolTip="{DynamicResource Loc.Pictures}"
                            Command="{Binding OpenKnownFolderCommand}"
                            CommandParameter="Pictures" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonSmall}"
                            Content="&#xE721;"
                            ToolTip="{DynamicResource Loc.FilterTip}"
                            Command="{Binding OpenFilterCommand}" />
                    <Button Style="{StaticResource IconButtonSmall}"
                            Content="&#xE710;"
                            ToolTip="{DynamicResource Loc.NewTabTip}"
                            Command="{Binding NewTabCommand}" />
                    <Button Style="{StaticResource IconButtonSmall}"
                            Content="&#xE72C;"
                            ToolTip="{DynamicResource Loc.RefreshTip}"
                            Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource IconButtonSmall}"
                            Content="&#xE8A7;"
                            ToolTip="{DynamicResource Loc.OpenInExplorer}"
                            Command="{Binding OpenInExplorerCommand}" />
                </StackPanel>
            </Grid>

            <!-- Navigation strip: breadcrumb by default, editable path on demand -->
            <Grid Grid.Row="1" Margin="6,0,4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,4,0">
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE72B;"
                            ToolTip="{DynamicResource Loc.Back}"
                            Command="{Binding GoBackCommand}" />
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE72A;"
                            ToolTip="{DynamicResource Loc.Forward}"
                            Command="{Binding GoForwardCommand}" />
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE74A;"
                            ToolTip="{DynamicResource Loc.Up}"
                            Command="{Binding GoUpCommand}" />
                </StackPanel>

                <!-- Breadcrumb -->
                <Border Grid.Column="1"
                        Background="{DynamicResource Surface.Subtle}"
                        BorderBrush="{DynamicResource Line.Soft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="2,0"
                        MinHeight="28"
                        Cursor="IBeam"
                        ToolTip="{DynamicResource Loc.EditPath}"
                        PreviewMouseLeftButtonDown="OnBreadcrumbMouseDown"
                        Visibility="{Binding IsAddressEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource CrumbButton}"
                                                Command="{Binding NavigateCommand}">
                                            <TextBlock Text="{Binding Label}" />
                                        </Button>
                                        <TextBlock Text="&#xE76C;"
                                                   FontFamily="{StaticResource Font.Icon}"
                                                   FontSize="8"
                                                   Foreground="{DynamicResource Text.Tertiary}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsLast, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Editable path -->
                <TextBox x:Name="AddressInput"
                         Grid.Column="1"
                         Style="{StaticResource AddressBox}"
                         Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnAddressKeyDown"
                         LostKeyboardFocus="OnAddressLostFocus"
                         Visibility="{Binding IsAddressEditing, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Rows + preview -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="140" MinWidth="112" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0"
                    Background="{DynamicResource Surface.Subtle}"
                    BorderBrush="{DynamicResource Line.Soft}"
                    BorderThickness="0,0,0,1"
                    Padding="8,8,8,7"
                    ToolTip="{DynamicResource Loc.ColumnTip}">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{DynamicResource Loc.Ascending}" Command="{Binding SortAscendingCommand}" />
                        <MenuItem Header="{DynamicResource Loc.Descending}" Command="{Binding SortDescendingCommand}" />
                        <Separator />
                        <MenuItem Header="{DynamicResource Loc.FoldersFirst}"
                                  IsCheckable="True"
                                  IsChecked="{Binding FoldersFirst, Mode=TwoWay}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid x:Name="ColumnHeaderGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="80" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition x:Name="SizeColumnDef" Width="72" MinWidth="48" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition x:Name="ModifiedColumnDef" Width="56" MinWidth="44" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition x:Name="KindColumnDef" Width="96" MinWidth="56" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ColumnHeaderButton}"
                            Command="{Binding SortByCommand}"
                            CommandParameter="{x:Static models:FileSortColumn.Name}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ColumnLabel}" Text="{DynamicResource Loc.Name}" />
                            <TextBlock Text="{Binding NameSortGlyph}" Style="{StaticResource ColumnSortGlyph}" />
                        </StackPanel>
                    </Button>
                    <GridSplitter Grid.Column="1"
                                  Style="{StaticResource ColumnSplitter}"
                                  DragCompleted="OnColumnDragCompleted" />
                    <Button Grid.Column="2" Style="{StaticResource ColumnHeaderButton}"
                            Command="{Binding SortByCommand}"
                            CommandParameter="{x:Static models:FileSortColumn.Size}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Style="{StaticResource ColumnLabel}" Text="{DynamicResource Loc.Size}" TextAlignment="Right" />
                            <TextBlock Text="{Binding SizeSortGlyph}" Style="{StaticResource ColumnSortGlyph}" />
                        </StackPanel>
                    </Button>
                    <GridSplitter Grid.Column="3"
                                  Style="{StaticResource ColumnSplitter}"
                                  DragCompleted="OnColumnDragCompleted" />
                    <Button Grid.Column="4" Style="{StaticResource ColumnHeaderButton}"
                            Command="{Binding SortByCommand}"
                            CommandParameter="{x:Static models:FileSortColumn.Modified}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource ColumnLabel}" Text="{DynamicResource Loc.Modified}" />
                            <TextBlock Text="{Binding ModifiedSortGlyph}" Style="{StaticResource ColumnSortGlyph}" />
                        </StackPanel>
                    </Button>
                    <GridSplitter Grid.Column="5"
                                  Style="{StaticResource ColumnSplitter}"
                                  DragCompleted="OnColumnDragCompleted" />
                    <Button Grid.Column="6" Style="{StaticResource ColumnHeaderButton}"
                            Command="{Binding SortByCommand}"
                            CommandParameter="{x:Static models:FileSortColumn.Kind}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Style="{StaticResource ColumnLabel}" Text="{DynamicResource Loc.Type}" />
                            <TextBlock Text="{Binding KindSortGlyph}" Style="{StaticResource ColumnSortGlyph}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ListBox x:Name="FilesList"
                     Grid.Row="1"
                     Grid.Column="0"
                     ItemsSource="{Binding VisibleItems}"
                     PreviewTextInput="OnFilesTextInput"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     SelectionMode="Extended"
                     ItemContainerStyle="{StaticResource FileRow}"
                     FocusVisualStyle="{x:Null}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="0"
                     Padding="0"
                     FontFamily="{StaticResource Font.Ui}"
                     FontSize="{StaticResource Size.FontBody}"
                     Foreground="{DynamicResource Text.Primary}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.CacheLength="1"
                     VirtualizingPanel.CacheLengthUnit="Page"
                     ScrollViewer.CanContentScroll="True"
                     SelectionChanged="OnFilesSelectionChanged"
                     PreviewKeyDown="OnFilesPreviewKeyDown"
                     MouseDoubleClick="OnItemDoubleClick"
                     PreviewMouseRightButtonUp="OnFilesRightClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="28"
                              Margin="8,0"
                              PreviewMouseMove="OnRowMouseMove">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="80" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="{Binding DataContext.SizeColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource DoubleToGridLength}}" MinWidth="48" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="{Binding DataContext.ModifiedColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource DoubleToGridLength}}" MinWidth="44" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="{Binding DataContext.KindColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource DoubleToGridLength}}" MinWidth="56" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Loaded="OnItemIconLoaded"
                                       DataContextChanged="OnItemIconContextChanged" />
                                <TextBlock x:Name="NameText"
                                           Grid.Column="1"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <TextBox x:Name="RenameBox"
                                         Grid.Column="1"
                                         Style="{StaticResource InlineRenameBox}"
                                         Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                                         IsVisibleChanged="OnRenameBoxIsVisibleChanged"
                                         LostFocus="OnRenameBoxLostFocus"
                                         PreviewKeyDown="OnRenameBoxPreviewKeyDown"
                                         PreviewMouseMove="OnRenameBoxMouseMove" />
                            </Grid>

                            <TextBlock x:Name="SizeText"
                                       Grid.Column="2"
                                       Text="{Binding SizeDisplay, Converter={StaticResource FileSize}}"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       FontSize="{StaticResource Size.FontSmall}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <TextBlock x:Name="TimeText"
                                       Grid.Column="4"
                                       Text="{Binding ModifiedUtc, Converter={StaticResource RelativeTime}}"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />

                            <TextBlock x:Name="KindText"
                                       Grid.Column="6"
                                       Text="{Binding TypeName}"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="&#xE721;"
                           FontFamily="{StaticResource Font.Icon}"
                           FontSize="18"
                           Foreground="{DynamicResource Text.Tertiary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBlock Text="{DynamicResource Loc.Searching}"
                           Foreground="{DynamicResource Text.Secondary}"
                           FontSize="13"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="10,0,10,10"
                    Padding="6,2,4,2"
                    MinWidth="160"
                    MaxWidth="240"
                    Background="{DynamicResource Surface.Card}"
                    BorderBrush="{DynamicResource Line.Soft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Panel.ZIndex="4"
                    Visibility="{Binding ShowFilterChrome, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE721;"
                               FontFamily="{StaticResource Font.Icon}"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Tertiary}"
                               VerticalAlignment="Center"
                               Margin="2,0,6,0" />
                    <TextBox x:Name="FilterBox"
                             Grid.Column="1"
                             Style="{StaticResource SearchField}"
                             ToolTip="{DynamicResource Loc.ClearFilterEsc}"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnFilterKeyDown"
                             LostKeyboardFocus="OnFilterLostFocus" />
                    <Button Grid.Column="2"
                            Width="20"
                            Height="20"
                            Style="{StaticResource IconButtonSmall}"
                            Content="&#xE711;"
                            ToolTip="{DynamicResource Loc.ClearFilter}"
                            Command="{Binding ClearFilterCommand}" />
                </Grid>
            </Border>

            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE"
                          ShowsPreview="False"
                          ResizeBehavior="PreviousAndNext">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border Width="1"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource Line.Soft}" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    Background="{DynamicResource Surface.Subtle}"
                    BorderBrush="{DynamicResource Line.Soft}"
                    BorderThickness="1,0,0,0"
                    Padding="8">
                <Border Background="{DynamicResource Surface.Card}"
                        BorderBrush="{DynamicResource Line.Soft}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">
                    <Grid>
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="{DynamicResource Loc.SelectToPreview}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   FontSize="12"
                                   Margin="8,0"
                                   Visibility="{Binding IsPreviewEmpty, Converter={StaticResource BoolToVisibility}}" />

                        <DockPanel Visibility="{Binding IsPreviewEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{DynamicResource Loc.Preview}"
                                       Style="{StaticResource ColumnLabel}"
                                       Margin="0,0,0,10" />
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding Preview.Title}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,4" />
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding Preview.Meta}"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       FontSize="11"
                                       Margin="0,0,0,10" />
                            <Border CornerRadius="8"
                                    Background="{DynamicResource Surface.Subtle}"
                                    Padding="6"
                                    Visibility="{Binding HasImagePreview, Converter={StaticResource BoolToVisibility}}">
                                <Image Source="{Binding Preview.Image}"
                                       Stretch="Uniform"
                                       MaxHeight="200" />
                            </Border>
                            <Border CornerRadius="8"
                                    Background="{DynamicResource Surface.Subtle}"
                                    Padding="8"
                                    Visibility="{Binding HasTextPreview, Converter={StaticResource BoolToVisibility}}">
                                <TextBox Text="{Binding Preview.Text, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource Text.Secondary}"
                                         FontFamily="Cascadia Mono, Consolas, monospace"
                                         FontSize="11"
                                         VerticalScrollBarVisibility="Auto" />
                            </Border>
                            <TextBlock Text="{Binding Preview.Hint}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       FontSize="12"
                                       VerticalAlignment="Top"
                                       Visibility="{Binding HasGenericPreview, Converter={StaticResource BoolToVisibility}}" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Border>
            </Grid>

            <!-- Footer: counts on the left, file actions on the right -->
            <Border Grid.Row="3"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Line.Soft}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0"
                    Padding="10,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding ItemSummary}"
                               Foreground="{DynamicResource Text.Tertiary}"
                               FontSize="{StaticResource Size.FontSmall}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonSmall}" Content="&#xE8F4;" ToolTip="{DynamicResource Loc.NewFolder}" Command="{Binding NewFolderCommand}" />
                        <Button Style="{StaticResource IconButtonSmall}" Content="&#xE8C8;" ToolTip="{DynamicResource Loc.Copy}" Command="{Binding CopySelectedCommand}" />
                        <Button Style="{StaticResource IconButtonSmall}" Content="&#xE8C6;" ToolTip="{DynamicResource Loc.Cut}" Command="{Binding CutSelectedCommand}" />
                        <Button Style="{StaticResource IconButtonSmall}" Content="&#xE77F;" ToolTip="{DynamicResource Loc.Paste}" Command="{Binding PasteCommand}" />
                        <Button Style="{StaticResource IconButtonDanger}" Content="&#xE74D;" ToolTip="{DynamicResource Loc.Delete}" Command="{Binding DeleteSelectedCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
