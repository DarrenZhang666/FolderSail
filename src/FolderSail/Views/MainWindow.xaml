<Window x:Class="FolderSail.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FolderSail.Views"
        xmlns:models="clr-namespace:FolderSail.Core.Models;assembly=FolderSail.Core"
        xmlns:vm="clr-namespace:FolderSail.ViewModels"
        Title="FolderSail"
        Width="1360"
        Height="860"
        MinWidth="980"
        MinHeight="620"
        Background="{StaticResource Surface.Window}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="{StaticResource Size.FontBody}"
        Foreground="{StaticResource Text.Primary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn"
                              Width="228"
                              MinWidth="{x:Static vm:MainViewModel.SidebarMinWidth}"
                              MaxWidth="{x:Static vm:MainViewModel.SidebarMaxWidth}" />
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- Opaque stage behind the file panes so Mica never leaks as black gaps. -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                Background="{StaticResource Surface.Canvas}" />

        <!-- ================= Sidebar: full height, frosted like Finder ================= -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                Background="{StaticResource Surface.Sidebar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="16,14,12,10"
                            VerticalAlignment="Center">
                    <Border Width="22" Height="22"
                            CornerRadius="6"
                            Background="{StaticResource Text.Primary}"
                            Opacity="0.82"
                            Margin="0,0,8,0">
                        <Canvas Width="22" Height="22">
                            <Path Fill="White" Data="M 11.2 4.2 L 11.2 13 L 5.4 13 Z" />
                            <Path Fill="White" Opacity="0.55" Data="M 12.2 7.2 L 16.4 13 L 12.2 13 Z" />
                            <Path Fill="White" Data="M 4.6 14.6 L 17.4 14.6 L 15.6 17.2 L 6.4 17.2 Z" />
                        </Canvas>
                    </Border>
                    <TextBlock Text="FolderSail"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="10,4,8,16"
                              FontFamily="{StaticResource Font.Ui}"
                              FontSize="{StaticResource Size.FontBody}"
                              Foreground="{StaticResource Text.Primary}">
                <StackPanel>

                    <!-- Jump targets -->
                    <TextBlock Text="快速跳转" Style="{StaticResource SectionLabel}" Margin="6,0,0,6" />

                    <Button Style="{StaticResource SidebarItemButton}"
                            Command="{Binding OpenThisPcCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE977;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                       Foreground="{StaticResource Text.Secondary}" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="此电脑" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarItemButton}"
                            Command="{Binding OpenKnownFolderCommand}" CommandParameter="Desktop">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                       Foreground="{StaticResource Text.Secondary}" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="桌面" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarItemButton}"
                            Command="{Binding OpenKnownFolderCommand}" CommandParameter="Documents">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                       Foreground="{StaticResource Text.Secondary}" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="文档" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarItemButton}"
                            Command="{Binding OpenKnownFolderCommand}" CommandParameter="Downloads">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                       Foreground="{StaticResource Text.Secondary}" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="下载" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarItemButton}"
                            Command="{Binding OpenKnownFolderCommand}" CommandParameter="Pictures">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                       Foreground="{StaticResource Text.Secondary}" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="图片" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Drives with capacity keel bars -->
                    <TextBlock Text="磁盘" Style="{StaticResource SectionLabel}" Margin="6,18,0,6" />

                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarItemButton}"
                                        Command="{Binding DataContext.OpenDriveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding CapacityText}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource Font.Icon}" FontSize="12"
                                                       Foreground="{StaticResource Text.Secondary}" Margin="0,0,9,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="{StaticResource Text.Tertiary}"
                                                       FontSize="10"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Usage bar -->
                                        <Grid x:Name="Track" Height="4" Margin="22,6,6,2">
                                            <Border Background="{StaticResource Line.Soft}" CornerRadius="2" />
                                            <Border HorizontalAlignment="Left"
                                                    CornerRadius="2"
                                                    Background="{StaticResource Text.Tertiary}">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource RatioToWidth}">
                                                        <Binding Path="UsedRatio" />
                                                        <Binding Path="ActualWidth" ElementName="Track" />
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding CapacityText}"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontSize="10"
                                                   Margin="21,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Colour tags, laid out like the Finder sidebar's Tags section -->
                    <TextBlock Text="标签"
                               Style="{StaticResource SectionLabel}"
                               Margin="6,18,0,6" />

                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Button Style="{StaticResource TagRow}"
                                                ToolTip="点击查看该标签的全部地址，也可把文件夹拖到这里"
                                                Command="{Binding OpenCommand}"
                                                DragEnter="OnTagDragEnter"
                                                DragOver="OnTagDragOver"
                                                DragLeave="OnTagDragLeave"
                                                Drop="OnTagDrop">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="为当前位置加此标签" Command="{Binding TagCurrentLocationCommand}" />
                                                    <MenuItem Header="重命名" Command="{Binding RenameCommand}" />
                                                    <MenuItem Header="清空此标签" Command="{Binding ClearCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="更改颜色">
                                                        <MenuItem Header="红色" Command="{Binding SetColorCommand}" CommandParameter="#D46A66" />
                                                        <MenuItem Header="橙色" Command="{Binding SetColorCommand}" CommandParameter="#D4925A" />
                                                        <MenuItem Header="黄色" Command="{Binding SetColorCommand}" CommandParameter="#C9A94A" />
                                                        <MenuItem Header="绿色" Command="{Binding SetColorCommand}" CommandParameter="#5FA87A" />
                                                        <MenuItem Header="蓝色" Command="{Binding SetColorCommand}" CommandParameter="#6A96C8" />
                                                        <MenuItem Header="紫色" Command="{Binding SetColorCommand}" CommandParameter="#9A7FB0" />
                                                        <MenuItem Header="灰色" Command="{Binding SetColorCommand}" CommandParameter="#8E8E93" />
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>

                                            <Grid Margin="0,0,24,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0"
                                                      Width="12" Height="12"
                                                      Margin="1,0,9,0"
                                                      VerticalAlignment="Center">
                                                    <Ellipse Fill="{Binding Color}" />
                                                    <Ellipse Stroke="#66FFFFFF" StrokeThickness="1" />
                                                </Grid>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ItemCount}"
                                                           Margin="6,0,0,0"
                                                           FontSize="10"
                                                           Foreground="{StaticResource Text.Tertiary}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Button>

                                        <!-- The right-hand disclosure button only expands the saved addresses. -->
                                        <Button Width="18"
                                                Height="18"
                                                Margin="0,0,4,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource IconButtonSmall}"
                                                ToolTip="展开或收起本地地址"
                                                IsEnabled="{Binding HasItems}"
                                                Command="{Binding ToggleExpandedCommand}">
                                            <Grid>
                                                <TextBlock Text="&#xE76C;"
                                                           Style="{StaticResource GlyphTextSmall}"
                                                           Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                                <TextBlock Text="&#xE70D;"
                                                           Style="{StaticResource GlyphTextSmall}"
                                                           Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Button>
                                    </Grid>

                                    <ItemsControl Grid.Row="1"
                                                  Margin="20,2,2,5"
                                                  ItemsSource="{Binding Items}"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource TagAddressRow}"
                                                            ToolTip="{Binding Path}"
                                                            Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="&#xE8B7;"
                                                                       Style="{StaticResource GlyphTextSmall}"
                                                                       Margin="0,1,7,0"
                                                                       VerticalAlignment="Top" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Path}"
                                                                           Margin="0,1,0,0"
                                                                           FontSize="9"
                                                                           Foreground="{StaticResource Text.Tertiary}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>

                                                    <Button Grid.Column="1"
                                                            Width="22"
                                                            Height="22"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource IconButtonDanger}"
                                                            Content="&#xE711;"
                                                            ToolTip="从此颜色标签移除（不会删除本地文件）"
                                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content toolbar sits only over the file stage, like Finder. -->
        <Border Grid.Row="0" Grid.Column="1"
                Background="{StaticResource Surface.Toolbar}"
                BorderBrush="{StaticResource Line.Soft}"
                BorderThickness="0,0,0,1"
                Padding="12,8,14,8">
            <DockPanel>
                <TextBlock Text="分屏"
                           DockPanel.Dock="Left"
                           Style="{StaticResource SectionLabel}"
                           VerticalAlignment="Center"
                           Margin="2,0,10,0" />
                <Border Background="{StaticResource Surface.Hover}"
                        CornerRadius="8"
                        Padding="3"
                        HorizontalAlignment="Left">
                    <ItemsControl ItemsSource="{Binding LayoutPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource LayoutSegment}"
                                             GroupName="Layout"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             ToolTip="{Binding Name}"
                                             Command="{Binding DataContext.SetLayoutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding Mode}">
                                    <views:LayoutGlyph Mode="{Binding Mode}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </DockPanel>
        </Border>

        <!-- Drag the seam to grow or shrink the navigation column. -->
        <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                      Style="{StaticResource SidebarSplitter}"
                      DragCompleted="OnSidebarSplitterDragCompleted" />

        <!-- ================= Pane host ================= -->
        <views:LayoutHost Grid.Row="1" Grid.Column="1"
                          Margin="8,6,10,6"
                          ItemsSource="{Binding Panes}"
                          LayoutMode="{Binding LayoutMode}" />

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="{StaticResource Surface.Toolbar}"
                BorderBrush="{StaticResource Line.Soft}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="6" Height="6"
                            CornerRadius="3"
                            Background="{StaticResource Accent.Base}"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="{StaticResource Size.FontSmall}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="拖拽复制 · Shift 拖拽移动 · F2 重命名 · F5 刷新"
                           Foreground="{StaticResource Text.Tertiary}"
                           FontSize="10"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
